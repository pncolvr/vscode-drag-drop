{
  "name": "drag-and-drop",
  "displayName": "drag-and-drop",
  "description": "Select files on explorer and send them to ripdrag to drop into other apps",
  "version": "0.0.2",
  "publisher": "pncolvr",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "drag-and-drop.runCommandOnFile",
        "title": "Drag",
        "category": "drag-and-drop",
        "supportsMultiSelect": true
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "drag-and-drop.runCommandOnFile",
          "when": "!explorerResourceIsFolder",
          "group": "9_cutcopypaste"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pncolvr/vscode-drag-drop"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
